# ============================================================
# Android
# ============================================================
# Gradle / Build
android/.gradle/
android/build/
android/app/build/
android/local.properties

# Signing keys (never commit)
android/key.properties
android/app/*.jks
android/app/*.keystore

# Build Variants & Intermediate Output
android/app/debug/
android/app/profile/
android/app/release/
android/app/intermediates/
android/app/.cxx/

# CMake / NDK / Captures
android/.cxx/
android/CMakeLists.txt.user
android/**/cmake-build-*/
android/captures/
android/out/
android/*.iml
android/.idea/

# Keep essential Gradle wrapper files
!android/gradlew
!android/gradlew.bat
!android/gradle/wrapper/gradle-wrapper.properties
!android/gradle/wrapper/gradle-wrapper.jar
!android/build.gradle
!android/settings.gradle

