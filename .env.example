# ==============================================================================
# Dharini configuration
#
# Copy this file to .env, in the folder that holds docker-compose.yml, and fill
# it in. Docker Compose and the backend both read it from there.
#
#   1. REQUIRED      review every value in this section before the first start
#   2. SIGN-IN       how one-time codes are sent: set up email or SMS
#   3. OPTIONAL      features that stay off until you set them
#   4. ADVANCED      defaults that suit most installs
#   5. DEVELOPMENT   local development only
#
# Every variable is described at
# https://dharini.artpark.ai/administrator-guide/environment-variables/
# ==============================================================================


# ==============================================================================
# 1. REQUIRED
# ==============================================================================

# --- Your site -----------------------------------------------------------------
# Replace dharini.example.org with the address people will open. The examples
# assume Nginx serves the web app at / and the API at /api (see the Nginx
# Configuration page in the docs).
NODE_ENV=production
# production | staging. Shows a "test data" banner when set to staging.
NEXT_PUBLIC_APP_ENV=production
# The address the browser uses to reach the API.
NEXT_PUBLIC_API_URL=https://dharini.example.org/api
# Browser origins allowed to call the API: scheme://host[:port], no path, no
# trailing slash, no "*". List every web app that calls the API (web frontend,
# mobile web). The backend will not start without it.
CORS_ORIGINS=https://dharini.example.org
# Base address for links in invitation emails and SMS. Must end with a slash.
FRONTEND_PLATFORM=https://dharini.example.org/

# --- Database (PostgreSQL + PostGIS) -------------------------------------------
# These work with the bundled postgres container. deploy.sh starts that
# container only while DB_HOST is `postgres`. For AWS RDS or another server, set
# DB_HOST to its address (the bundled container then does not start) and
# DB_SSL=true.
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dharini_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_SSL=false

# --- Redis (cache and queues) --------------------------------------------------
# These work with the bundled redis container.
REDIS_HOST=redis
REDIS_PORT=6379

# --- Secrets -------------------------------------------------------------------
# Signs login tokens. Use a long random value, for example: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# --- First super admin ---------------------------------------------------------
# Created at startup if no user has this email yet. You sign in with it using a
# one-time code, so email or SMS (section 2) must work. Leave
# SUPER_ADMIN_EMAIL empty to skip. The name defaults to "Super Admin"; the phone
# number is optional.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_FIRST_NAME=
SUPER_ADMIN_LAST_NAME=
SUPER_ADMIN_PHONE=

# --- File storage (S3-compatible: AWS S3 or the bundled Garage) ----------------
# Photos and uploads are stored here. The bucket needs a CORS rule for browser
# uploads (see the Production Setup page).
#   AWS S3: set S3_REGION and a key pair; leave S3_ENDPOINT empty. If the key
#           pair is empty too, the AWS default credentials are used (for
#           example an instance role).
#   Garage: S3_ENDPOINT=http://garage:3900 and S3_REGION=garage. setup.sh
#           creates the bucket and keys for you.
S3_REGION=
S3_ACCESSKEYID=
S3_SECRETACCESSKEY=
S3_ENDPOINT=
S3_BUCKET=dharini-bucket
S3_FOLDER=uploads
# Garage only: the public address of the /s3 proxy, so browsers can upload.
S3_PUBLIC_URL=

# --- Uploads -------------------------------------------------------------------
# The defaults are fine to keep.
DEFAULT_IMAGE_THUMBNAIL=default_thumbnail.png
MAX_FILE_ALLOW_UPLOAD=10
SIGNED_URL_EXPIRY=3600

# --- Background jobs -----------------------------------------------------------
# Visit scheduling. Keep these as they are.
QUEUE=dharini-queue
JOB_SCHEDULER=visit-scheduler
JOB_SCHEDULE_REPEAT_PATTERN=0 0 * * *

# --- Genomics pipeline ---------------------------------------------------------
# The backend reads these three at startup, so they must be present. Leave them
# empty if you do not use sequencing; more settings are in section 3.
PIPELINE_URL=
PIPELINE_CALLBACK_URL=
WEBHOOK_SECRET=


# ==============================================================================
# 2. SIGN-IN: how one-time codes are sent
# Users sign in with a code sent by email or SMS. Set up at least one.
# ==============================================================================

# --- Email (SMTP) ---------------------------------------------------------------
# Any SMTP server. EMAIL_FROM must be an address or domain verified with your
# provider.
#   AWS SES: SMTP_HOST=email-smtp.<region>.amazonaws.com, port 587 (STARTTLS) or
#            465 (TLS), and the SMTP credentials made in the SES console.
#   Resend:  SMTP_HOST=smtp.resend.com, SMTP_USER=resend, SMTP_PASS=<API key>.
#   Gmail:   SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, your address as SMTP_USER
#            and an app password as SMTP_PASS.
EMAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- SMS -----------------------------------------------------------------------
# SMS_PROVIDER=console prints messages to the log instead of sending them.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# ==============================================================================
# 3. OPTIONAL: features that stay off until you set them
# ==============================================================================

# --- Android app download button ----------------------------------------------
# The login page shows a download button when this is set. Use the link to your
# APK, for example the GitHub Release made by the Mobile CI workflow (see the
# Mobile App page in the docs). Empty hides the button.
NEXT_PUBLIC_APK_DOWNLOAD_URL=

# --- Web app switches ----------------------------------------------------------
# Only the exact value "true" turns these on.
NEXT_PUBLIC_SUPER_ADMIN_LAB_FLOW=false

# --- Analytics (PostHog) -------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- GeoLens map layers --------------------------------------------------------
# Bird sightings (https://ebird.org/api/keygen) and current weather
# (https://openweathermap.org/api). Each layer stays empty without its key.
EBIRD_API_KEY=
OWM_API_KEY=

# --- Predictions (bird migration, livestock disease risk) ----------------------
# The backend relays /ml/* to a separate dharini-ml prediction service and adds
# this key, which never reaches the browser. Leave both empty to turn it off:
# /ml/* then answers 404 and the web app hides these features. Ask the service's
# operator for the address and a key; each environment gets its own key.
ML_SERVICE_URL=
ML_API_KEY=

# --- Genomics pipeline (more settings) -----------------------------------------
# PIPELINE_URL, PIPELINE_CALLBACK_URL and WEBHOOK_SECRET are in section 1.
PIPELINE_API_KEY=
SEQUENCING_MAX_UPLOAD_BYTES=5368709120
# Must match the pipeline service's own upload prefix exactly: it rejects any
# input_key outside it. Defaults to genomic-sequencing/uploads. Keys look like
#   {S3_FOLDER}/{SEQUENCING_UPLOAD_PREFIX}/{userId}/{uploadId}/{filename}
SEQUENCING_UPLOAD_PREFIX=
# Age, in seconds, before a run that has not finished is checked against the
# pipeline. Defaults to 3600. Set it low locally, where the webhook cannot reach
# localhost and this check is the only way a run ever finishes.
SEQUENCING_RECONCILE_AFTER_S=


# ==============================================================================
# 4. ADVANCED: defaults that suit most installs
# ==============================================================================

# --- Docker images (used by docker-compose.yml and deploy.sh) ------------------
# deploy.sh sets IMAGE_TAG from its argument (staging or production). Set it
# here only when you run `docker compose` yourself: production, staging or
# sha-<commit>.
# IMAGE_TAG=production
# Docker Hub namespace the images are pulled from. Change it if you publish your
# own images.
# IMAGE_REGISTRY=dsihartpark

# --- Database connection pool --------------------------------------------------
# Tune DB_POOL_MAX to the max_connections of your Postgres or RDS instance, and
# raise it first if you see connection timeouts under load.
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONN_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# --- Extra data files ----------------------------------------------------------
# Folder the seeder reads GeoLens data files from, before its built-in one.
# docker-compose.yml sets this to the mounted ./geolens-data folder; set it
# yourself only when you run the backend outside Docker. File names are in
# DATA_SOURCES.md.
GEOLENS_DATA_DIR=


# ==============================================================================
# 5. DEVELOPMENT: local development only
# ==============================================================================

# Enables the fixed one-time code 123456. It only works when NODE_ENV is not
# "production", whatever this is set to. Keep it false everywhere except a local
# or deliberately controlled test environment.
ALLOW_FIXED_OTP=false

# pgAdmin (the development and staging profiles only).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
